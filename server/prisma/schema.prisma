generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          String    @default("STAFF")
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdProducts     Product[]           @relation("ProductCreator")
  updatedProducts     Product[]           @relation("ProductUpdater")
  receipts            Receipt[]           @relation("ReceiptCreator")
  deliveries          Delivery[]          @relation("DeliveryCreator")
  transfers           Transfer[]          @relation("TransferCreator")
  adjustments         Adjustment[]        @relation("AdjustmentCreator")
  stockMoves          StockMove[]         @relation("StockMoveUser")
  validatedReceipts   Receipt[]           @relation("ReceiptValidator")
  validatedDeliveries Delivery[]          @relation("DeliveryValidator")
  validatedTransfers  Transfer[]          @relation("TransferValidator")
  validatedAdjustments Adjustment[]       @relation("AdjustmentValidator")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]
}

model UnitOfMeasure {
  id          String   @id @default(cuid())
  name        String   @unique
  symbol      String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Warehouse {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  address     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  locations    Location[]
  receipts     Receipt[]
  deliveries   Delivery[]
}

model Location {
  id           String    @id @default(cuid())
  name         String
  code         String
  type         String    @default("STORAGE")
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       Location? @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Location[] @relation("LocationHierarchy")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([warehouseId, code])

  stockMoves    StockMove[]
  receipts      Receipt[]
  deliveries    Delivery[]
  transfersFrom Transfer[] @relation("TransferFromLocation")
  transfersTo   Transfer[] @relation("TransferToLocation")
  adjustments   Adjustment[]
}

model Product {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  description   String?
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  uomId         String
  uom           UnitOfMeasure @relation(fields: [uomId], references: [id])
  reorderPoint  Int      @default(10)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String
  createdBy     User     @relation("ProductCreator", fields: [createdById], references: [id])
  updatedById   String?
  updatedBy     User?    @relation("ProductUpdater", fields: [updatedById], references: [id])

  stockMoves        StockMove[]
  receiptLines      ReceiptLine[]
  deliveryLines     DeliveryLine[]
  transferLines     TransferLine[]
  adjustmentLines   AdjustmentLine[]
}

model StockMove {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId    String
  location      Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  qtyDelta      Int
  refType       String
  refId         String
  userId        String
  user          User         @relation("StockMoveUser", fields: [userId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([productId, locationId])
  @@index([refType, refId])
}

model Receipt {
  id          String       @id @default(cuid())
  supplier    String
  status      String       @default("DRAFT")
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  locationId  String
  location    Location     @relation(fields: [locationId], references: [id])
  createdById String
  createdBy   User         @relation("ReceiptCreator", fields: [createdById], references: [id])
  validatedById String?
  validatedBy   User?      @relation("ReceiptValidator", fields: [validatedById], references: [id])
  validatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  lines ReceiptLine[]
}

model ReceiptLine {
  id           String   @id @default(cuid())
  receiptId    String
  receipt      Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qtyOrdered   Int
  qtyReceived  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([receiptId, productId])
}

model Delivery {
  id          String       @id @default(cuid())
  customer    String
  status      String       @default("DRAFT")
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  locationId  String
  location    Location     @relation(fields: [locationId], references: [id])
  createdById String
  createdBy   User         @relation("DeliveryCreator", fields: [createdById], references: [id])
  validatedById String?
  validatedBy   User?      @relation("DeliveryValidator", fields: [validatedById], references: [id])
  validatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  lines DeliveryLine[]
}

model DeliveryLine {
  id            String    @id @default(cuid())
  deliveryId    String
  delivery      Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  qtyOrdered    Int
  qtyDelivered  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([deliveryId, productId])
}

model Transfer {
  id            String       @id @default(cuid())
  fromLocationId String
  fromLocation   Location     @relation("TransferFromLocation", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Location     @relation("TransferToLocation", fields: [toLocationId], references: [id])
  status         String       @default("DRAFT")
  createdById    String
  createdBy      User         @relation("TransferCreator", fields: [createdById], references: [id])
  validatedById  String?
  validatedBy    User?        @relation("TransferValidator", fields: [validatedById], references: [id])
  validatedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lines TransferLine[]
}

model TransferLine {
  id           String    @id @default(cuid())
  transferId   String
  transfer     Transfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty          Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([transferId, productId])
}

model Adjustment {
  id          String       @id @default(cuid())
  locationId  String
  location    Location     @relation(fields: [locationId], references: [id])
  reason      String
  status      String       @default("DRAFT")
  createdById String
  createdBy   User         @relation("AdjustmentCreator", fields: [createdById], references: [id])
  validatedById String?
  validatedBy   User?      @relation("AdjustmentValidator", fields: [validatedById], references: [id])
  validatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  lines AdjustmentLine[]
}

model AdjustmentLine {
  id             String     @id @default(cuid())
  adjustmentId   String
  adjustment     Adjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId      String
  product        Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  systemQty      Int
  countedQty     Int
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([adjustmentId, productId])
}